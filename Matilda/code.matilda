schema Transactions = {
    ID : int,
    Transaction : string,
    Amount : int,
    test: bool
}

schema SummedTransactionsByTransaction = {
    Transaction : string
    Amount : int,
}

schema SummedTransactionsById = {
    ID : int,
    Amount : int
}

table<Transactions> transactions = read("test.csv");

table<SummedTransactionsByTransaction> summedTransactions = SUM(transactions, Transaction, Amount, SummedTransactionsByTransaction);
table<SummedTransactionsById> summedTransactions2 = SUM(transactions, ID, Amount, SummedTransactionsById);